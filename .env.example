# Air Quality Health Impact Dashboard — Environment Variables
# Copy this file to backend/.env and fill in your real API keys.
# Never commit .env or real keys to GitHub.

# Server port (optional, default 5000)
PORT=5000

# OpenWeatherMap Air Pollution API
# Get a key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# AQICN (World Air Quality Index) API
# Get a token at: https://aqicn.org/api/
AQICN_API_KEY=your_aqicn_api_key_here

# OpenCage Geocoding API (city name → lat/lon)
# Get a key at: https://opencagedata.com/api
OPENCAGE_API_KEY=your_opencage_api_key_here
